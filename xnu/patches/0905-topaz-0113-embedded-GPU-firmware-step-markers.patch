From f13c4d1985890f38b857fba1328903207da5f6de Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 19 Oct 2026 14:30:54 +0300
Subject: [PATCH 905/947] topaz-0113: embedded GPU firmware, step markers

---
 iokit/Kernel/arm/TopazAdreno.cpp   |   28 +-
 iokit/Kernel/arm/TopazAdrenoFw.cpp | 2606 ++++++++++++++++++++++++++++
 iokit/conf/files.arm64             |    1 +
 3 files changed, 2621 insertions(+), 14 deletions(-)
 create mode 100644 iokit/Kernel/arm/TopazAdrenoFw.cpp

diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index b812ebd..a2b5cd3 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -32,6 +32,8 @@ void topaz_fw_free(void *data, size_t size);
 int topaz_root_mounted(void);
 void RedwoodGPUStart(void);
 void topaz_adreno_init(void);
+extern const uint8_t topaz_fw_zap_mdt[], topaz_fw_zap_b02[], topaz_fw_sqe_fw[];
+extern const size_t topaz_fw_zap_mdt_size, topaz_fw_zap_b02_size, topaz_fw_sqe_fw_size;
 
 bool redwood_gpu_ready(void);
 bool redwood_gpu_parameter(uint32_t which, uint64_t *value);
@@ -296,11 +298,11 @@ zap_load(void)
 	struct kbuf meta = {};
 	bool ok = false;
 
-	if (topaz_fw_read(FW_DIR "a610_zap.mdt", &mdt, &mdt_size) || topaz_fw_read(FW_DIR "a610_zap.b02", &seg, &seg_size) ||
-	    mdt_size < 52) {
-		IOLog("TopazGPU: zap files missing in " FW_DIR "\n");
-		goto out;
-	}
+	IOLog("TopazGPU: zap: embedded firmware (%zu + %zu bytes)\n", topaz_fw_zap_mdt_size, topaz_fw_zap_b02_size);
+	mdt = (void *)topaz_fw_zap_mdt;
+	mdt_size = topaz_fw_zap_mdt_size;
+	seg = (void *)topaz_fw_zap_b02;
+	seg_size = topaz_fw_zap_b02_size;
 	{
 		const uint8_t *m = (const uint8_t *)mdt;
 		uint32_t phoff = *(const uint32_t *)(m + 28), phnum = *(const uint16_t *)(m + 44);
@@ -326,6 +328,7 @@ zap_load(void)
 			IOLog("TopazGPU: zap metadata of %zu bytes does not fit one page\n", mdt_size);
 			goto out;
 		}
+		IOLog("TopazGPU: zap: metadata at %#llx\n", meta.pa);
 		memcpy(meta.va, mdt, mdt_size);
 		__asm__ volatile ("dsb sy" ::: "memory");
 		scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, GPU_PAS_ID, 0, 0, &res);
@@ -339,6 +342,7 @@ zap_load(void)
 			IOLog("TopazGPU: zap mem_setup: %llx/%llx\n", st, res);
 			goto out;
 		}
+		IOLog("TopazGPU: zap: init_image and mem_setup ok, copying the segment\n");
 		volatile uint8_t *dst = (volatile uint8_t *)ml_io_map(ZAP_REGION, ZAP_REGION_SIZE);
 		if (dst == NULL) {
 			goto out;
@@ -357,8 +361,6 @@ zap_load(void)
 	}
 out:
 	OSSafeReleaseNULL(meta.md);
-	topaz_fw_free(mdt, mdt_size);
-	topaz_fw_free(seg, seg_size);
 	return ok;
 }
 
@@ -455,6 +457,7 @@ smmu_fault(const char *tag)
 static bool
 smmu_setup(void)
 {
+	IOLog("TopazGPU: smmu: tables\n");
 	if (l1.va == NULL && !table_alloc(&l1)) {
 		return false;
 	}
@@ -658,20 +661,17 @@ cp_start(void)
 	void *fw = NULL;
 	size_t fw_size = 0;
 
-	if (topaz_fw_read(FW_DIR "a630_sqe.fw", &fw, &fw_size) || fw_size <= 4) {
-		IOLog("TopazGPU: " FW_DIR "a630_sqe.fw missing\n");
-		topaz_fw_free(fw, fw_size);
-		return false;
-	}
+	fw = (void *)topaz_fw_sqe_fw;
+	fw_size = topaz_fw_sqe_fw_size;
+	IOLog("TopazGPU: cp: SQE %zu bytes, allocating ring\n", fw_size);
 	if ((sqe.md == NULL && (!kbuf_alloc(&sqe, fw_size - 4) || !kbuf_map(&sqe))) ||
 	    (ring.md == NULL && (!kbuf_alloc(&ring, RB_BYTES) || !kbuf_map(&ring))) ||
 	    (mem.md == NULL && (!kbuf_alloc(&mem, PAGE_SIZE) || !kbuf_map(&mem)))) {
 		IOLog("TopazGPU: CP buffers failed\n");
-		topaz_fw_free(fw, fw_size);
 		return false;
 	}
 	memcpy(sqe.va, (const uint8_t *)fw + 4, fw_size - 4);
-	topaz_fw_free(fw, fw_size);
+	IOLog("TopazGPU: cp: SQE at GPU %#llx, ring %#llx\n", sqe.iova, ring.iova);
 	tlb_flush();
 	hw_init_regs();
 	gpu_wr64(0x830, sqe.iova);                      /* CP_SQE_INSTR_BASE */
diff --git a/iokit/Kernel/arm/TopazAdrenoFw.cpp b/iokit/Kernel/arm/TopazAdrenoFw.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/TopazAdrenoFw.cpp
@@ -0,0 +1,15 @@
+extern "C" {
+/*
+ * ginkgo: no GPU firmware in the source tree. With these zero sizes TopazAdreno
+ * reads a610_zap.mdt, a610_zap.b02 and a630_sqe.fw from /usr/share/firmware/topaz/
+ * on the root (the owner's own /vendor/firmware copies; patch 0951).
+ */
+#include <stdint.h>
+#include <stddef.h>
+extern const uint8_t topaz_fw_zap_mdt[1] = {0};
+extern const uint8_t topaz_fw_zap_b02[1] = {0};
+extern const uint8_t topaz_fw_sqe_fw[1] = {0};
+extern const size_t topaz_fw_zap_mdt_size = 0;
+extern const size_t topaz_fw_zap_b02_size = 0;
+extern const size_t topaz_fw_sqe_fw_size = 0;
+}
diff --git a/iokit/conf/files.arm64 b/iokit/conf/files.arm64
index a346878..c92beb0 100644
--- a/iokit/conf/files.arm64
+++ b/iokit/conf/files.arm64
@@ -23,6 +23,7 @@ iokit/Kernel/arm/SweetWatchdog.cpp                               optional iokitc
 iokit/Kernel/arm/SweetSurface.cpp                                optional iokitcpp
 iokit/Kernel/arm/SweetFramebuffer.cpp                            optional iokitcpp
 iokit/Kernel/arm/TopazAdreno.cpp                                 optional iokitcpp
+iokit/Kernel/arm/TopazAdrenoFw.cpp                               optional iokitcpp
 iokit/Kernel/arm/RedwoodGPU.cpp                                  optional iokitcpp
 iokit/Kernel/arm/SweetBattery.cpp                                optional iokitcpp
 iokit/Kernel/arm/hid/SweetHID.cpp                                optional iokitcpp
-- 
