From: ios-ginkgo <x@x>
Subject: [PATCH] ginkgo: Adreno 610 on SM6125 (zap region 0x57515000, GPU pool
 0x64000000+384 MB, firmware from the root instead of embedded)

---
diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index 16da336..6ee951f 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -64,7 +64,8 @@ uint32_t gpu_log;
 #define SMMU_BASE       0x059A0000ull
 #define SMMU_SIZE       0x10000
 #define SMMU_CB0        0x8000
-#define ZAP_REGION      0x55B15000ull
+/* ginkgo (SM6125): DT gpu_region@57515000, size 0x2000 (topaz SM6225: 0x55B15000) */
+#define ZAP_REGION      0x57515000ull
 #define ZAP_REGION_SIZE 0x2000
 #define GPU_PAS_ID      13
 
@@ -159,8 +160,13 @@ kbuf_pa(struct kbuf *b, uint64_t off)
  * reserved regions in the stock DT, not given to the kernel): a pool of it is
  * the GPU's, mapped write-combined (Normal non-cacheable: no cache upkeep).
  */
-#define GPU_POOL_BASE       0x90000000ull
-#define GPU_POOL_SIZE       0x40000000ull       /* 1 GB */
+/*
+ * ginkgo: the kernel owns 0x82000000-0x13fffffff (mkadt.py --ginkgo), so topaz's pool at
+ * 0x90000000 would be kernel RAM. 0x64000000-0x7c000000 is DDR (/proc/iomem: System RAM
+ * 61600000-7dcfffff) that neither ABL's carve-outs nor the kernel use: 6 chunks of 64 MB.
+ */
+#define GPU_POOL_BASE       0x64000000ull
+#define GPU_POOL_SIZE       0x18000000ull       /* 384 MB */
 #define GPU_POOL_UNIT       0x10000ull          /* 64 KB */
 #define GPU_POOL_CHUNK      0x4000000ull        /* 64 MB: mapped on first use (1 GB at once is more IO space than there is) */
 #define GPU_POOL_CHUNKS     (GPU_POOL_SIZE / GPU_POOL_CHUNK)
@@ -572,12 +578,23 @@ zap_load(void)
 	size_t mdt_size = 0, seg_size = 0;
 	struct kbuf meta = {};
 	bool ok = false;
+	bool from_fs = topaz_fw_zap_mdt_size == 0;
 
-	IOLog("TopazGPU: zap: embedded firmware (%zu + %zu bytes)\n", topaz_fw_zap_mdt_size, topaz_fw_zap_b02_size);
-	mdt = (void *)topaz_fw_zap_mdt;
-	mdt_size = topaz_fw_zap_mdt_size;
-	seg = (void *)topaz_fw_zap_b02;
-	seg_size = topaz_fw_zap_b02_size;
+	if (from_fs) {
+		/* ginkgo: the owner's own /vendor/firmware a610_zap.mdt + .b02, copied to the root */
+		if (topaz_fw_read(FW_DIR "a610_zap.mdt", &mdt, &mdt_size) || topaz_fw_read(FW_DIR "a610_zap.b02", &seg, &seg_size) ||
+		    mdt_size < 52) {
+			IOLog("TopazGPU: zap files missing in " FW_DIR "\n");
+			goto out;
+		}
+		IOLog("TopazGPU: zap: " FW_DIR " (%zu + %zu bytes)\n", mdt_size, seg_size);
+	} else {
+		IOLog("TopazGPU: zap: embedded firmware (%zu + %zu bytes)\n", topaz_fw_zap_mdt_size, topaz_fw_zap_b02_size);
+		mdt = (void *)topaz_fw_zap_mdt;
+		mdt_size = topaz_fw_zap_mdt_size;
+		seg = (void *)topaz_fw_zap_b02;
+		seg_size = topaz_fw_zap_b02_size;
+	}
 	{
 		const uint8_t *m = (const uint8_t *)mdt;
 		uint32_t phoff = *(const uint32_t *)(m + 28), phnum = *(const uint16_t *)(m + 44);
@@ -637,6 +654,10 @@ zap_load(void)
 	}
 out:
 	OSSafeReleaseNULL(meta.md);
+	if (from_fs) {
+		topaz_fw_free(mdt, mdt_size);
+		topaz_fw_free(seg, seg_size);
+	}
 	return ok;
 }
 
@@ -955,18 +976,33 @@ cp_start(void)
 {
 	void *fw = NULL;
 	size_t fw_size = 0;
+	bool from_fs = topaz_fw_sqe_fw_size == 0;
 
-	fw = (void *)topaz_fw_sqe_fw;
-	fw_size = topaz_fw_sqe_fw_size;
+	if (from_fs) {
+		if (topaz_fw_read(FW_DIR "a630_sqe.fw", &fw, &fw_size) || fw_size <= 4) {
+			IOLog("TopazGPU: " FW_DIR "a630_sqe.fw missing\n");
+			topaz_fw_free(fw, fw_size);
+			return false;
+		}
+	} else {
+		fw = (void *)topaz_fw_sqe_fw;
+		fw_size = topaz_fw_sqe_fw_size;
+	}
 	IOLog("TopazGPU: cp: SQE %zu bytes, allocating ring\n", fw_size);
 	if ((sqe.md == NULL && (!kbuf_alloc(&sqe, fw_size - 4) || !kbuf_map(&sqe))) ||
 	    (ring.md == NULL && (!kbuf_alloc(&ring, RB_BYTES) || !kbuf_map(&ring))) ||
 	    (mem.md == NULL && (!kbuf_alloc(&mem, PAGE_SIZE) || !kbuf_map(&mem)))) {
 		IOLog("TopazGPU: CP buffers failed\n");
+		if (from_fs) {
+			topaz_fw_free(fw, fw_size);
+		}
 		return false;
 	}
 	memcpy(sqe.va, (const uint8_t *)fw + 4, fw_size - 4);
 	sweet_dcache_clean((vm_offset_t)sqe.va, (unsigned)(fw_size - 4));
+	if (from_fs) {
+		topaz_fw_free(fw, fw_size);
+	}
 	IOLog("TopazGPU: cp: SQE at GPU %#llx, ring %#llx\n", sqe.iova, ring.iova);
 	tlb_flush();
 	hw_init_regs();
